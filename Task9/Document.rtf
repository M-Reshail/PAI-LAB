\pard\sa200\sl276\slmult1\b\f0\fs22\lang9 Name: Muhammad Reshail\par
Class: BSAI(4A)-053\par
\par
 Objective:\par
\b0  The purpose of this mini-project is to perform sentiment analysis on user-provided sentences using \par
the VADER sentiment analyzer. The system classifies each input sentence as Positive, Negative, or \par
Neutral based on sentiment scores.\par
\ul\b\fs28\par
Code:\par
\ulnone\b0\par
from vaderSentiment.vaderSentiment import SentimentIntensityAnalyzer\par
\par
def sentiment_scores(sentence):\par
\par
    sid_obj = SentimentIntensityAnalyzer()\par
\par
    sentiment_dict = sid_obj.polarity_scores(sentence)\par
    \par
    print("Overall sentiment dictionary is : ", sentiment_dict)\par
    print("Sentence was rated as ", sentiment_dict['neg']*100, "% Negative")\par
    print("Sentence was rated as ", sentiment_dict['neu']*100, "% Neutral")\par
    print("Sentence was rated as ", sentiment_dict['pos']*100, "% Positive")\par
\par
    print("Sentence Overall Rated As", end=" ")\par
\par
    if sentiment_dict['compound'] >= 0.05 :\par
        print("Positive")\par
    elif sentiment_dict['compound'] <= -0.05 :\par
        print("Negative")\par
    else :\par
        print("Neutral")\par
\par
if __name__ == "__main__" :\par
\par
    print("\\n1st Statement:")\par
    sentence = input("Enter sentence:")\par
    sentiment_scores(sentence)\par
\par
    print("\\n2nd Statement:")\par
    sentence = input("Enter sentence:")\par
    sentiment_scores(sentence)\par
\par
    print("\\n3rd Statement:")\par
    sentence = input("Enter sentence:")\par
    sentiment_scores(sentence)\par

