Templates\\index.html\par
\ulnone\b0 <!DOCTYPE html>\par
<html lang="en">\par
<head>\par
 <meta charset="UTF-8">\par
 <title>Foodie's Paradise Chatbot</title>\par
 <link rel="stylesheet" href="\{\{ url_for('static', filename='style.css') \}\}">\par
</head>\par
<body>\par
 <div class="chat-container">\par
   <h2> The Food Lounge </h2>\par
   <div id="chat-box" class="chat-box"></div>\par
   <div class="input-container">\par
     <input type="text" id="user-input" placeholder="Type your message...">\par
     <button onclick="sendMessage()">Send</button>\par
   </div>\par
 </div>\par
 <script>\par
   async function sendMessage() \{\par
     const userInput = document.getElementById('user-input').value;\par
     if (userInput.trim() === "") return;\par
     const chatBox = document.getElementById('chat-box');\par
     chatBox.innerHTML += `<div class="user-message">$\{userInput\}</div>`;\par
     const response = await fetch("/chat", \{\par
        method: "POST",\par
        body: JSON.stringify(\{ message: userInput \}),\par
        headers: \{\par
          "Content-Type": "application/json"\par
        \}\par
      \});\par
      const data = await response.json();\par
      chatBox.innerHTML += `<div class="bot-message">$\{data.response\}</div>`;\par
      document.getElementById('user-input').value = "";\par
      chatBox.scrollTop = chatBox.scrollHeight;\par
    \}\par
  </script>\par
 </body>\par
