\pard\sa200\sl240\slmult1\b\f0\fs30\lang9 Name:Reshail\par
Class: BSAI(4A)-053\par
\ul\fs24 Objective:\ulnone\b0\par
 In this project we have to develop a simple, dynamic, and interactive food chatbot using Flask, \par
HTML/CSS, and Python.\par
 The chatbot can answer customer queries about the menu, food options, bookings, and some offers.\par
\ul\b  Functionalities:\ulnone\b0\par
 \f1\bullet\f0  Menu Inquiry: Customers can ask about menu items like pizza, burgers, pasta, biryani, BBQ, \par
desserts, and drinks.\par
 \f1\bullet\f0  Food Details: When a specific item (like "burger" or "pasta") is mentioned, it shows available \par
options.\par
 \f1\bullet\f0  Booking Feature: Customers can ask to "book a table" or "make a reservation" and get \par
booking instructions.\par
 \f1\bullet\f0  Friendly Interaction: Replies to greetings like "hi", "hello" and closes conversations with \par
"bye" messages. \par
\ul\b How It Works:\ulnone\b0\par
\b  1. Frontend:\b0\par
 \f1\bullet\f0  User types a message in the chatbot window.\par
 \f1\bullet\f0  Message is sent to /chat through API.\par
\b  2. Backend (Flask):\par
\b0  \f1\bullet\f0  Flask receives the message.\par
 \f1\bullet\f0  Message is matched with predefined pairs of question/answers using regular \par
expressions.\par
 \f1\bullet\f0  Appropriate response is sent back.\par
\b  3. Response:\b0\par
 \f1\bullet\f0  Chatbot shows a friendly, dynamic answer on the webpage.\par

\pard\sa200\sl240\slmult1\qc\b\f2\fs30 Code\par

\pard\sa200\sl240\slmult1 app.py\par
\fs22 from flask import Flask, render_template, request, jsonify\par
from main import get_chatbot_response, analyze_sentiment \par
\par
app = Flask(__name__)\par
\par
@app.route("/")\par
def home():\par
    return render_template("index.html")\par
\par
@app.route("/chat", methods=["POST"])\par
def chat():\par
    user_input = request.json["message"]\par
    \par
    if user_input.lower() == "sentiment":\par
        return jsonify(\{"response": "Tell me a sentence and I'll analyze the mood!"\})\par
    \par
    elif user_input.startswith("analyze:"):\par
        sentiment_text = user_input.replace("analyze:", "").strip()\par
        sentiment_result = analyze_sentiment(sentiment_text)\par
        return jsonify(\{"response": f"Sentiment Analysis Result \{sentiment_result\}"\})\par
    \par
    else:\par
        response = get_chatbot_response(user_input)\par
        return jsonify(\{"response": response\})\par
\par
if __name__ == "__main__":\par
    app.run(debug=True)\par
\par
\par
\ul\fs30 MAIN.PY:\par
\ulnone\fs22 import nltk\par
from nltk.chat.util import Chat, reflections\par
from nltk.sentiment import SentimentIntensityAnalyzer\par
\par
nltk.download('punkt')\par
nltk.download('vader_lexicon')\par
\par
pairs = [\par
    [r"(?i).*hello.*|.*hi.*|.*hey.*",\par
     ["Hey there! Welcome to The Food Lounge! What would you like today?"]],\par
    \par
    [r"(?i).*menu.*",\par
     ["Our menu is packed with love!We have pizzas, burgers, pasta, biryani, BBQ, desserts, and much more!"]],\par
    \par
    [r"(?i).*burger.*|.*burgers.*",\par
     ["Our burgers are juicy and delicious! Options: Classic Beef, Chicken Supreme, Veggie Delight."]],\par
    \par
    [r"(?i).*pizza.*|.*pizzas.*",\par
     ["Hot and cheesy pizzas await you! Options: Margherita, Pepperoni, BBQ Chicken, Veggie Special."]],\par
    \par
    [r"(?i).*pasta.*",\par
     ["We serve creamy Alfredo, spicy Arrabiata, and classic Bolognese pasta!"]],\par
    \par
    [r"(?i).*biryani.*",\par
     ["Aromatic biryani for you! Options: Chicken Biryani, Mutton Biryani, and Veg Biryani."]],\par
    \par
    [r"(?i).*bbq.*",\par
     ["Smoky and tender BBQ dishes! Options: BBQ Wings, Ribs, and BBQ Platters."]],\par
    \par
    [r"(?i).*dessert.*|.*sweet.*",\par
     ["Dessert time!Options: Chocolate Lava Cake, Cheesecake, Ice Cream Sundae."]],\par
    \par
    [r"(?i).*drinks.*|.*beverage.*",\par
     ["Refreshing drinks available! Options: Lemonade, Mojito, Cold Coffee, Fresh Juices."]],\par
    \par
    [r"(?i).*booking.*|.*book.*|.*reservation.*",\par
     ["Sure! To book a table, please call us at +123-456-7890 or visit our website to reserve online!"]],\par
    \par
    [r"(?i).*thanks.*|.*thank you.*",\par
     ["You're welcome! Enjoy your meal!"]],\par
    \par
    [r"(?i).*bye.*|.*goodbye.*|.*see you.*",\par
     ["Goodbye! Come again!"]],\par
]\par
\par
chatbot = Chat(pairs, reflections)\par
sia = SentimentIntensityAnalyzer()\par
\par
def get_chatbot_response(user_input):\par
    response = chatbot.respond(user_input)\par
    if response:\par
        return response\par
    else:\par
        return "I'm not sure about that. Try asking about food, booking, or offers!"\par
\par
def analyze_sentiment(text):\par
    sentiment_score = sia.polarity_scores(text)\par
    if sentiment_score['compound'] >= 0.05:\par
        return "Positive Sentence"\par
    elif sentiment_score['compound'] <= -0.05:\par
        return "Negative Sentence"\par
    else:\par
        return "Neutral Sentence"\par
